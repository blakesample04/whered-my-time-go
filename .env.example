# Copy this file to .env for local `netlify dev` testing. In production,
# set these as environment variables in Netlify's dashboard instead
# (Site configuration → Environment variables) — never commit real values.
# See the "Manual steps" section of the billing setup for where each of
# these comes from in the Stripe dashboard.

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...
